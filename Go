-- ==========================================
-- 2. ระบบ Noclip
-- ==========================================
RunService.Stepped:Connect(function()
    if autoStealActive and character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

local function interact(obj)
    if obj:IsA("ProximityPrompt") then
        fireproximityprompt(obj)
    elseif obj:IsA("ClickDetector") then
        fireclickdetector(obj)
    end
end

-- ==========================================
-- 3. ระบบเก็บเงินอัตโนมัติ
-- ==========================================
local function doAutoCollectMoney()
    while autoCollectMoneyActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        
        if root and firetouchinterest then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "AutoCollect" or obj.Name == "Touch") then
                    if obj:IsDescendantOf(workspace:FindFirstChild("Plot_" .. player.Name) or workspace) then
                        firetouchinterest(root, obj, 0)
                        task.wait(0.05)
                        firetouchinterest(root, obj, 1)
                    end
                end
            end
        end
        task.wait(2)
    end
end

-- ==========================================
-- 4. ระบบ Instant Steal แบบกรองตามระดับ/ธีม
-- ==========================================
local function doAutoSteal()
    while autoStealActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        
        if root then
            for _, obj in pairs(workspace:GetDescendants()) do
                if not autoStealActive then break end
                
                if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
                    local parentPart = obj.Parent
                    if parentPart and (parentPart:IsA("BasePart") or parentPart:IsA("Model")) then
                        
                        -- เช็กว่าเป็นบ้านคนอื่นไหม
                        local isInOtherPlot = false
                        local ancestor = parentPart.Parent
                        while ancestor and ancestor ~= workspace do
                            if string.find(ancestor.Name, "Plot_") and ancestor.Name ~= ("Plot_" .. player.Name) then
                                isInOtherPlot = true
                                break
                            end
                            ancestor = ancestor.Parent
                        end
                        
                        if not isInOtherPlot then
                            -- ตรวจสอบว่าชื่อชิ้นงานหรือข้อความด้านบนตรงกับระดับ/ธีมที่คุณเลือกไว้ไหม
                            local matchFilter = false
                            local itemName = parentPart.Name
                            
                            -- เช็กจากชื่อวัตถุ หรือ Attribute ข้างใน (ถ้ามี)
                            for filterName, isSelected in pairs(selectedFilters) do
                                if isSelected then
                                    if string.find(string.lower(itemName), string.lower(filterName)) then
                                        matchFilter = true
                                        break
                                    end
                                    -- เช็กเผื่อเกมเก็บค่าไว้ใน Attribute หรือ Child ของชิ้นงาน
                                    if parentPart:GetAttribute(filterName) or parentPart:FindFirstChild(filterName) then
                                        matchFilter = true
                                        break
                                    end
                                end
                            end
                            
                            -- ถ้าไม่ได้เลือกฟิลเตอร์อะไรเลย หรือเลือกแล้วตรงกัน -> ทำการวาร์ปขโมยทันที
                            local hasAnyFilter = false
                            for _, v in pairs(selectedFilters) do if v then hasAnyFilter = true break end end
                            
                            if not hasAnyFilter or matchFilter then
                                local originalCFrame = root.CFrame
                                local targetCF = parentPart:IsA("Model") and parentPart:GetPivot() or parentPart.CFrame
                                
                                root.CFrame = targetCF + Vector3.new(0, 2, 0)
                                task.wait(0.05)
                                
                                for i = 1, 4 do
                                    interact(obj)
                                    task.wait(0.05)
                                end
                                
                                root.CFrame = originalCFrame
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end
            
            -- วาร์ปไปขายของชั่วคราว
            if autoStealActive then
                local sellNPC = workspace:FindFirstChild("SellNPC")
                if sellNPC and sellNPC:FindFirstChild("HumanoidRootPart") then
                    local originalCFrame = root.CFrame
                    root.CFrame = sellNPC.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                    task.wait(0.3)
                    
                    for _, obj in pairs(sellNPC:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
                            interact(obj)
                            task.wait(0.05)
                        end
                    end
                    task.wait(0.5)
                    root.CFrame = originalCFrame
                end
            end
        end
        task.wait(0.5)
    end
end

